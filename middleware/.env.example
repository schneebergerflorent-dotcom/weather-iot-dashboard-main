# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Google Cloud ──────────────────────────────────────────────────────────────
GCP_PROJECT=finial-project-494209
BQ_DATASET=Lab4_IoT_datasets
BQ_TABLE=weather-records

# ── Device auth (must match PASSWD constant in device/main.py) ───────────────
DEVICE_PASSWD=your_device_password_here

# ── OpenWeatherMap free-tier key (REQUIRED) ───────────────────────────────────
OWM_API_KEY=your_owm_key_here
OWM_CITY=Lausanne
OWM_COUNTRY=CH

# ── OpenRouter key for LLM / TTS / STT (REQUIRED) ────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional model overrides
# LLM_MODEL=google/gemini-2.5-flash-lite
# TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
# STT_MODEL=openai/whisper-1

# Port (Cloud Run sets this automatically; leave as-is for local dev)
PORT=8080
